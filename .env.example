# SkillSwap Environment Configuration Template
# Copy this file to .env for local development and set real values.
# NEVER commit .env or real credentials to version control.

# Django Core Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-random-50-character-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
# Option 1: Individual database environment variables
DB_ENGINE=django.db.backends.postgresql
DB_NAME=skillswap
DB_USER=replace-with-db-username
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=5432

# Option 2: Full PostgreSQL connection URL (overrides DB_* variables when set)
# DATABASE_URL=postgresql://username:password@localhost:5432/skillswap

# Explicit Frontend CORS & CSRF Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:55900,http://127.0.0.1:55900
CSRF_TRUSTED_ORIGINS=http://localhost:55900,http://127.0.0.1:55900

# Redis Channel Layer URL (Required when DJANGO_DEBUG=False; optional in local dev)
REDIS_URL=redis://127.0.0.1:6379/0
